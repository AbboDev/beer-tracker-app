{
  "expo": {
    "name": "Beer Tracker",
    "slug": "beer-tracker-app",
    "scheme": "beertracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "L'app usa la fotocamera per scansionare il QR code sulle bottiglie."
        }
      ]
    ],
    "web": {
      "output": "server",
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.beertracker"
    },
    "android": {
      "package": "com.example.beertracker",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4c7578e1-1ab3-443a-a6e3-bb68a24c8424"
      }
    }
  }
}
